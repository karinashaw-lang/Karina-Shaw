      "months": 24,
      "why": "General contract principles are comparatively stable."
    },
    "property": {
      "months": 12,
      "why": "Tenancy rules (deposits, notice periods, entry) move on local legislative cycles."
    },
    "money": {
      "months": 24,
      "why": "Private-loan drafting conventions are comparatively stable; rate caps still deserve a periodic look."
    },
    "partnership": {
      "months": 24,
      "why": "Partnership drafting conventions are stable; buyout and dissolution terms deserve a periodic look."
    },
    "agreements": {
      "months": 24,
      "why": "Short-form service terms are stable; payment and IP defaults track market practice slowly."
    },
    "invoice": {
      "months": 24,
      "why": "Payment-terms drafting conventions are stable."
    },
    "businessplan": {
      "months": 12,
      "why": "A narrative-only document with no citations to age — reviewed yearly on general principle, not because anything in it goes stale faster."
    }
  },

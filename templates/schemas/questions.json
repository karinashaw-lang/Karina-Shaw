{
  "$comment": "The wizard itself, as data (spec §1.1). Questions carry a `when` condition in the same expression language as rules, so the question set changes with the package without any change to the engine. `required` gates the generate button.",
  "version": "1.0.0",
  "questions": [
    {
      "id": "package",
      "type": "choice",
      "default": "formation",
      "prompt": "What do you need to put in place?",
      "help": "Selects the document package. Everything below adapts to this answer.",
      "options": {
        "taxonomy": "packages"
      }
    },
    {
      "id": "company",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "What is your name, or your company’s name?",
      "help": "Used as your party name throughout the package — a person’s name works the same as a company’s.",
      "placeholder": "e.g. Northwind Labs, or Jordan Alvarez"
    },
    {
      "id": "entity",
      "type": "choice",
      "default": "llc",
      "prompt": "What entity type?",
      "help": "Drives the charter document, the governing document, and the tax default.",
      "when": {
        "rule": "pkg_formation"
      },
      "options": {
        "taxonomy": "entities"
      }
    },
    {
      "id": "formState",
      "type": "choice",
      "default": "DE",
      "prompt": "Which state will you form in?",
      "help": "Determines the filing, the statute, and the governing law default.",
      "when": {
        "rule": "pkg_formation"
      },
      "options": {
        "taxonomy": "jurisdictions"
      }
    },
    {
      "id": "opState",
      "type": "choice",
      "default": "CA",
      "prompt": "Where does the business actually operate?",
      "help": "Drives state-specific provisions, and in the formation package triggers foreign qualification.",
      "options": {
        "taxonomy": "jurisdictions"
      }
    },
    {
      "id": "founders",
      "type": "choice",
      "default": 2,
      "prompt": "How many founders or partners?",
      "help": "Drives transfer restrictions, buy-sell, and deadlock provisions — and the signature block.",
      "when": {
        "any": [
          {
            "rule": "pkg_formation"
          },
          {
            "rule": "pkg_partnership"
          }
        ]
      },
      "options": {
        "literal": [
          [
            1,
            "Just me"
          ],
          [
            2,
            "2"
          ],
          [
            3,
            "3"
          ],
          [
            4,
            "4+"
          ]
        ]
      },
      "namesFor": "founderNames"
    },
    {
      "id": "industry",
      "type": "choice",
      "default": "saas",
      "prompt": "What industry?",
      "help": "Filters the clause library and selects industry-specific provisions.",
      "options": {
        "taxonomy": "industries"
      }
    },
    {
      "id": "funding",
      "type": "choice",
      "default": "angel",
      "prompt": "What is the funding plan?",
      "help": "Institutional plans pull in vesting, acceleration, and drag-along.",
      "when": {
        "rule": "pkg_formation"
      },
      "options": {
        "taxonomy": "fundingStages"
      }
    },
    {
      "id": "employees",
      "type": "choice",
      "default": true,
      "prompt": "Hiring employees in the next 12 months?",
      "help": "Adds employment policy stubs and state wage-and-hour requirements.",
      "when": {
        "rule": "pkg_formation"
      },
      "options": {
        "literal": [
          [
            true,
            "Yes"
          ],
          [
            false,
            "No"
          ]
        ]
      }
    },
    {
      "id": "counterparty",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "Who is on the other side?",
      "help": "The counterparty’s legal name, used as a defined term throughout the contract set.",
      "when": {
        "any": [
          {
            "rule": "pkg_commercial"
          },
          {
            "rule": "pkg_agreements"
          }
        ]
      },
      "placeholder": "e.g. Acme Corporation"
    },
    {
      "id": "role",
      "type": "choice",
      "default": "provider",
      "prompt": "Which side are you on?",
      "help": "Every cap, warranty, indemnity, and termination right flips with this answer.",
      "when": {
        "any": [
          {
            "rule": "pkg_commercial"
          },
          {
            "rule": "pkg_agreements"
          }
        ]
      },
      "options": {
        "taxonomy": "contractRoles"
      }
    },
    {
      "id": "dealSize",
      "type": "choice",
      "default": "mid",
      "prompt": "Roughly how large is the deal?",
      "help": "Sets the liability cap multiple and whether audit, insurance, and security review terms are included.",
      "when": {
        "rule": "pkg_commercial"
      },
      "options": {
        "taxonomy": "dealSizes"
      }
    },
    {
      "id": "termMonths",
      "type": "choice",
      "default": 12,
      "prompt": "How long is the initial term?",
      "help": "Drives the term, renewal, and termination-for-convenience mechanics.",
      "when": {
        "rule": "pkg_commercial"
      },
      "options": {
        "literal": [
          [
            12,
            "12 months"
          ],
          [
            24,
            "24 months"
          ],
          [
            36,
            "36 months"
          ]
        ]
      }
    },
    {
      "id": "autoRenew",
      "type": "choice",
      "default": true,
      "prompt": "Should the term auto-renew?",
      "help": "Auto-renewal needs express notice mechanics, and several states regulate it directly.",
      "when": {
        "rule": "pkg_commercial"
      },
      "options": {
        "literal": [
          [
            true,
            "Yes"
          ],
          [
            false,
            "No"
          ]
        ]
      }
    },
    {
      "id": "engagement",
      "type": "choice",
      "default": "employee",
      "prompt": "Employee or contractor?",
      "help": "These are not interchangeable documents, and using the wrong one is itself evidence of misclassification.",
      "when": {
        "rule": "pkg_hiring"
      },
      "options": {
        "literal": [
          [
            "employee",
            "Employee"
          ],
          [
            "contractor",
            "Independent contractor"
          ]
        ]
      }
    },
    {
      "id": "roleTitle",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "What is the role called?",
      "help": "Appears in the offer, the agreement, and the classification analysis.",
      "when": {
        "rule": "pkg_hiring"
      },
      "placeholder": "e.g. Senior Software Engineer"
    },
    {
      "id": "comp",
      "type": "choice",
      "default": "salary",
      "prompt": "How is the role paid?",
      "help": "Hourly pulls in overtime, timekeeping, and break obligations; salary still has to pass the duties test.",
      "when": {
        "all": [
          {
            "rule": "pkg_hiring"
          },
          {
            "eq": [
              "engagement",
              "employee"
            ]
          }
        ]
      },
      "options": {
        "taxonomy": "compTypes"
      }
    },
    {
      "id": "equityGrant",
      "type": "choice",
      "default": true,
      "prompt": "Is equity part of the offer?",
      "help": "Adds award terms, vesting, and the approval path the grant actually depends on.",
      "when": {
        "all": [
          {
            "rule": "pkg_hiring"
          },
          {
            "eq": [
              "engagement",
              "employee"
            ]
          }
        ]
      },
      "options": {
        "literal": [
          [
            true,
            "Yes"
          ],
          [
            false,
            "No"
          ]
        ]
      }
    },
    {
      "id": "remote",
      "type": "choice",
      "default": false,
      "prompt": "Will they work remotely from another state?",
      "help": "A remote hire creates tax nexus, registration duties, and expense obligations where they sit.",
      "when": {
        "rule": "pkg_hiring"
      },
      "options": {
        "literal": [
          [
            true,
            "Yes"
          ],
          [
            false,
            "No"
          ]
        ]
      }
    },
    {
      "id": "headcount",
      "type": "choice",
      "default": 1,
      "prompt": "How many employees will the company have?",
      "help": "California obligations switch on at 5, 10, 15, 50, and 100 employees. This is the answer that decides most of them.",
      "when": {
        "any": [
          {
            "all": [
              {
                "rule": "pkg_formation"
              },
              {
                "truthy": "employees"
              }
            ]
          },
          {
            "rule": "employee_engagement"
          }
        ]
      },
      "options": {
        "taxonomy": "headcountBands"
      }
    },
    {
      "id": "caCity",
      "type": "choice",
      "default": "none",
      "prompt": "Which California city do employees work in?",
      "help": "Local ordinances follow where the employee physically works — including a remote employee's home city — and commonly exceed the state floor.",
      "when": {
        "all": [
          {
            "eq": [
              "opState",
              "CA"
            ]
          },
          {
            "any": [
              {
                "all": [
                  {
                    "rule": "pkg_formation"
                  },
                  {
                    "truthy": "employees"
                  }
                ]
              },
              {
                "rule": "employee_engagement"
              }
            ]
          }
        ]
      },
      "options": {
        "taxonomy": "californiaLocalities"
      }
    },
    {
      "id": "tenantName",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "Who is the other person?",
      "help": "The tenant on a lease, the subtenant on a sublease, or your roommate.",
      "when": {
        "rule": "pkg_property"
      },
      "placeholder": "e.g. Riley Chen"
    },
    {
      "id": "propertyAddress",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "What is the address of the property?",
      "help": "The premises being rented, exactly as you want it to appear in the lease.",
      "when": {
        "rule": "pkg_property"
      },
      "placeholder": "e.g. 12 Rose Lane, Apt 4"
    },
    {
      "id": "monthlyRent",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "What is the monthly rent?",
      "help": "Written into the rent clause exactly as you type it — include the currency.",
      "when": {
        "rule": "pkg_property"
      },
      "placeholder": "e.g. $1,800"
    },
    {
      "id": "securityDeposit",
      "type": "text",
      "default": "",
      "prompt": "How much is the security deposit?",
      "help": "Leave blank for no deposit. Some places cap deposits — checking that is part of adapting the lease to where the property is.",
      "when": {
        "rule": "pkg_property"
      },
      "placeholder": "e.g. $1,800 — leave blank for none"
    },
    {
      "id": "leaseTerm",
      "type": "choice",
      "default": "fixed12",
      "prompt": "How long is the tenancy?",
      "help": "A fixed term ends on a date; month-to-month continues until one side gives notice.",
      "when": {
        "rule": "pkg_property"
      },
      "options": {
        "literal": [
          [
            "fixed12",
            "12-month fixed term"
          ],
          [
            "fixed6",
            "6-month fixed term"
          ],
          [
            "fixed24",
            "24-month fixed term"
          ],
          [
            "m2m",
            "Month-to-month"
          ]
        ]
      }
    },
    {
      "id": "petsAllowed",
      "type": "choice",
      "default": false,
      "prompt": "Are pets allowed?",
      "help": "Selects the pets clause the lease starts with — you can edit or remove it on the page.",
      "when": {
        "rule": "pkg_property"
      },
      "options": {
        "literal": [
          [
            true,
            "Yes"
          ],
          [
            false,
            "No"
          ]
        ]
      }
    },
    {
      "id": "utilitiesIncluded",
      "type": "choice",
      "default": false,
      "prompt": "Are utilities included in the rent?",
      "help": "Decides which side the utilities clause puts the bills on.",
      "when": {
        "rule": "pkg_property"
      },
      "options": {
        "literal": [
          [
            true,
            "Included in rent"
          ],
          [
            false,
            "Tenant pays separately"
          ]
        ]
      }
    },
    {
      "id": "borrowerName",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "Who is borrowing the money?",
      "help": "Used as the defined term “Borrower”. You are the Lender.",
      "when": {
        "rule": "pkg_money"
      },
      "placeholder": "e.g. Casey Morgan"
    },
    {
      "id": "principalAmount",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "How much is being lent?",
      "help": "The principal, written exactly as you type it — include the currency.",
      "when": {
        "rule": "pkg_money"
      },
      "placeholder": "e.g. $10,000"
    },
    {
      "id": "interestText",
      "type": "text",
      "default": "",
      "prompt": "What interest, if any?",
      "help": "Leave blank for an interest-free loan. Some places cap interest rates — checking that is part of adapting the documents to where you are.",
      "when": {
        "rule": "pkg_money"
      },
      "placeholder": "e.g. 5% per year — leave blank for none"
    },
    {
      "id": "repayment",
      "type": "choice",
      "default": "installments",
      "prompt": "How is it paid back?",
      "help": "Picks the repayment clause: a monthly schedule, one payment on a date, or whenever the lender asks.",
      "when": {
        "rule": "pkg_money"
      },
      "options": {
        "literal": [
          [
            "installments",
            "Monthly installments"
          ],
          [
            "lump",
            "One payment on a set date"
          ],
          [
            "demand",
            "On demand"
          ]
        ]
      }
    },
    {
      "id": "securedLoan",
      "type": "choice",
      "default": false,
      "prompt": "Is the loan secured by any property?",
      "help": "If yes, the documents include a collateral clause with a blank for describing the property.",
      "when": {
        "rule": "pkg_money"
      },
      "options": {
        "literal": [
          [
            true,
            "Yes — there is collateral"
          ],
          [
            false,
            "No — unsecured"
          ]
        ]
      }
    },
    {
      "id": "serviceDesc",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "What is the work?",
      "help": "One plain sentence describing the services. It goes into the agreement exactly as you write it.",
      "when": {
        "rule": "pkg_agreements"
      },
      "placeholder": "e.g. brand and website design for the spring launch"
    },
    {
      "id": "payText",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "What is the payment?",
      "help": "Amount and timing, in your own words — written into the payment clause as-is.",
      "when": {
        "rule": "pkg_agreements"
      },
      "placeholder": "e.g. $4,000 — half up front, half on delivery"
    },
    {
      "id": "deadlineText",
      "type": "text",
      "default": "",
      "prompt": "Is there a deadline?",
      "help": "Leave blank if the work has no fixed completion date.",
      "when": {
        "rule": "pkg_agreements"
      },
      "placeholder": "e.g. October 15, 2026 — leave blank for none"
    },
    {
      "id": "partnershipPurpose",
      "type": "text",
      "default": "",
      "required": true,
      "prompt": "What is the partnership for?",
      "help": "One plain sentence describing the business. It becomes the stated purpose.",
      "when": {
        "rule": "pkg_partnership"
      },
      "placeholder": "e.g. a management consulting practice"
    }
  ]
}

{
  "$comment": "Auto-population layer (spec §1.3). Every {{token}} used in a clause body must be defined here — tools/validate.mjs fails the build otherwise. `provenance` is shown to the user so an auto-filled value is never anonymous.",
  "version": "1.0.0",
  "resolvers": {
    "answer": "value of a wizard answer field",
    "const": "fixed string",
    "taxonomy": "[answerField, collection, property] lookup in taxonomy.json",
    "today": "current date, long format",
    "todayPlusDays": "current date + N days, long format",
    "template": "string with {{other_field}} tokens, resolved after its dependencies",
    "choose": "{if: expr, then: resolver, else: resolver} using the rules expression language",
    "builtin": "named function in the engine — used only where formatting cannot be expressed declaratively",
    "reference": "[collection, key] direct lookup in a flat reference table in taxonomy.json"
  },

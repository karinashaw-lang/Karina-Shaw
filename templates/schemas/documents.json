{
  "$comment": "Document package schema (spec §1.1). `include` decides whether the document is generated at all; `groupOrder` fixes article order within it. Every clause must declare a group that appears in its document's groupOrder — validate.mjs enforces this so a clause can never be silently dropped during numbering. Each document declares the `package` it belongs to, so the UI can distinguish a document excluded within the chosen package from one that belongs to a different package entirely, and `label` gives it a stable name for library views where the templated title has nothing to interpolate.",
  "version": "1.0.0",
  "documents": [
    {
      "id": "charter",
      "icon": "📜",
      "numbering": "article",
      "order": 1,
      "name": {
        "taxonomy": [
          "entity",
          "entities",
          "charter"
        ]
      },
      "include": {
        "rule": "pkg_formation"
      },
      "rationale": "Always required — this is the filing that creates the entity.",
      "groupOrder": [
        "Charter",
        "General Provisions"
      ],
      "package": "formation",
      "label": "Charter filing"
    },
    {
      "id": "governance",
      "icon": "📗",
      "numbering": "section",
      "order": 2,
      "name": {
        "taxonomy": [
          "entity",
          "entities",
          "governance"
        ]
      },
      "include": {
        "rule": "pkg_formation"
      },
      "rationale": "Always required — governs how the owners run the Company.",
      "groupOrder": [
        "Organization",
        "Governance",
        "Economics",
        "Ownership Transfers",
        "Regulatory Compliance",
        "General Provisions"
      ],
      "package": "formation",
      "label": "Governing document"
    },
    {
      "id": "ip-assignment",
      "icon": "🔐",
      "numbering": "section",
      "order": 3,
      "name": {
        "const": "Founder IP Assignment"
      },
      "include": {
        "all": [
          {
            "rule": "pkg_formation"
          },
          {
            "any": [
              {
                "rule": "ip_critical"
              },
              {
                "rule": "multi_founder"
              }
            ]
          }
        ]
      },
      "rationale": "Included when the industry is IP-critical or there is more than one founder — either way, ownership of the work has to sit with the Company rather than with an individual.",
      "groupOrder": [
        "Assignment",
        "Protections",
        "General Provisions"
      ],
      "package": "formation",
      "label": "Founder IP Assignment"
    },
    {
      "id": "vesting",
      "icon": "⏳",
      "numbering": "section",
      "order": 4,
      "name": {
        "const": "Founder Vesting Agreement"
      },
      "include": {
        "all": [
          {
            "rule": "pkg_formation"
          },
          {
            "any": [
              {
                "rule": "institutional"
              },
              {
                "rule": "multi_founder"
              }
            ]
          }
        ]
      },
      "rationale": "Included for institutional funding or multiple founders — vesting is what protects the team from an early departure taking dead equity with them.",
      "groupOrder": [
        "Schedule",
        "Company Rights",
        "General Provisions"
      ],
      "package": "formation",
      "label": "Founder Vesting Agreement"
    },
    {
      "id": "election-83b",
      "icon": "🧾",
      "numbering": "section",
      "order": 5,
      "name": {
        "const": "IRS Section 83(b) Election"
      },
      "include": {
        "all": [
          {
            "rule": "pkg_formation"
          },
          {
            "rule": "file_83b"
          }
        ]
      },
      "rationale": "Included for C-Corp stock subject to vesting. The filing deadline is 30 days and cannot be extended.",
      "groupOrder": [
        "Election",
        "General Provisions"
      ],
      "package": "formation",
      "label": "IRS Section 83(b) Election"
    },
    {
      "id": "consent",

# Required
DATABASE_URL="postgresql://app:app@localhost:5432/creatorplatform?schema=public"
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional — the app derives its own origin from the incoming request without
# this, which is fine for local dev but should be set explicitly in
# production (behind a proxy/CDN) so Stripe/Mux callback URLs are correct.
# APP_URL="https://your-domain.com"

# Optional — Stripe. Without these, tips/subscriptions are simulated ledger
# entries with no real payment behind them. With them, tips/subscriptions go
# through real Stripe Checkout, confirmed via webhook.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."  # from `stripe listen` locally, or the dashboard in production

# Optional — Mux. Without these, video uploads are saved to local disk and
# live streaming is unavailable. With them, uploads go direct-to-Mux for
# transcoding/HLS playback, and creators can go live over RTMP.
# MUX_TOKEN_ID="..."
# MUX_TOKEN_SECRET="..."
# MUX_WEBHOOK_SECRET="..."  # from the Mux dashboard's webhook settings

# Optional — OpenAI. Without this, transcripts are pasted in manually and the
# commute briefing is unavailable. With it, file uploads are auto-transcribed
# with Whisper, and viewers can generate a GPT+TTS commute briefing from
# their wall.
# OPENAI_API_KEY="sk-..."

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  name                 String
  stripeCustomerId     String?              @unique
  /// A distributor payout account (Stripe Connect Express) — separate from
  /// CreatorProfile's own stripeAccountId, since any viewer can be a
  /// distributor regardless of whether they're also a creator. See
  /// src/lib/actions/distributor.ts.
  stripeAccountId      String?              @unique
  stripeChargesEnabled Boolean              @default(false)
  createdAt            DateTime             @default(now())
  creatorProfile       CreatorProfile?
  comments             Comment[]
  follows              Follow[]
  clips                Clip[]
  wallItems            WallItem[]
  tipsSent             Tip[]
  subscriptions        Subscription[]
  briefings            Briefing[]
  partyMessages        PartyMessage[]
  partyRsvps           PartyRsvp[]
  wallCards            WallCard[]
  dailyActivity        DailyActivity[]
  guestFollows         GuestFollow[]
  recapReels           RecapReel[]
  liveChatMessages     LiveChatMessage[]
  liveClipRequests     LiveClipRequest[]
  dubsRequested        Dub[]
  distributorLinks     DistributorLink[]
  distributorEarnings  DistributorEarning[]
  behindTheCutUnlocks  BehindTheCutUnlock[]
  askedQuestions       AskedQuestion[]
  videoExtraUnlocks    VideoExtraUnlock[]
  paidQuestionsSent    PaidQuestion[]
}

model CreatorProfile {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id])
  handle                 String          @unique
  displayName            String
  bio                    String?
  subscriptionPriceCents Int?
  /// Null means paid questions aren't offered — see PaidQuestion.
  questionPriceCents     Int?
  /// Stripe Connect Express account for direct creator payouts. Null means
  /// the creator hasn't onboarded yet, so tips/subscriptions (when Stripe is
  /// configured) are charged to the platform's own account instead of being
  /// routed to the creator — see src/lib/integrations/stripe.ts.
  stripeAccountId        String?         @unique
  /// True once Stripe reports charges_enabled for the connected account
  /// (via the account.updated webhook) — only then are payments routed to it.
  stripeChargesEnabled   Boolean         @default(false)
  createdAt              DateTime        @default(now())
  videos                 Video[]
  followers              Follow[]
  tipsReceived           Tip[]
  subscribers            Subscription[]
  liveStream             LiveStream?
  askedQuestions         AskedQuestion[]
  paidQuestions          PaidQuestion[]
}

enum VideoStatus {
  PROCESSING
  READY
  ERRORED
}

model Video {
  id                    String              @id @default(cuid())
  creatorId             String
  creator               CreatorProfile      @relation(fields: [creatorId], references: [id])
  title                 String
  description           String?
  /// Null while a Mux-hosted upload is still processing (see `status`).
  videoUrl              String?
  /// Audio-only stream, so the platform works when someone is just
  /// listening (see the business plan's "audio-optional by default").
  /// Extracted with ffmpeg on local file uploads only — see
  /// src/lib/audio-extraction.ts. Null for pasted-URL and Mux uploads.
  audioUrl              String?
  status                VideoStatus         @default(READY)
  /// Set for uploads routed through Mux (see src/lib/integrations/mux.ts).
  muxUploadId           String?             @unique
  muxAssetId            String?
  muxPlaybackId         String?
  subscriberOnly        Boolean             @default(false)
  /// Early access, per the plan: while set and in the future, only
  /// subscribers (and the owner) can watch — same lock screen as
  /// subscriberOnly. Unlike subscriberOnly, this expires: once the date
  /// passes, the video opens to everyone regardless of subscription,
  /// distinguishing "early" from "exclusive."
  earlyAccessUntil      DateTime?
  /// The free "effort badge" shown on every public video — makes the paid
  /// Behind the Cut section feel earned. All optional and creator-entered;
  /// the badge only renders if at least one is set.
  effortHours           Float?
  effortReshoots        Int?
  effortMinutesCut      Int?
  createdAt             DateTime            @default(now())
  /// Cached result of the last AI highlight-detection pass (see
  /// src/lib/highlights.ts) — GPT runs on page view otherwise, and this is
  /// a passive, non-user-triggered call unlike the rest of the OpenAI
  /// integrations, so it's worth not repeating on every load. Invalidated
  /// whenever the transcript is re-saved (see highlightsComputedAt below).
  highlightsJson        Json?
  /// Set alongside highlightsJson; the cache is valid as long as no
  /// transcript segment was (re)created after this.
  highlightsComputedAt  DateTime?
  comments              Comment[]
  clips                 Clip[]
  wallItems             WallItem[]
  transcript            TranscriptSegment[]
  listeningParties      ListeningParty[]
  guests                VideoGuest[]
  dubs                  Dub[]
  curatedMoments        CuratedMoment[]
  behindTheCut          BehindTheCut?
  extras                VideoExtra[]
  paidQuestionsAnswered PaidQuestion[]
}

/// The per-video paid companion section — the plan's "Behind the Cut."
/// Five fixed slots (plan/rawFootage/cutScenes/kit/hardPart), every one
/// optional: "any slot can be empty; the raw footage alone is enough to
/// sell." Presence of any non-empty slot is what makes the section exist
/// at all for viewers — there's no separate publish/draft flag. Unlocked
/// per video (default $3) or included free with a subscription to the
/// creator.
model BehindTheCut {
  id            String               @id @default(cuid())
  videoId       String               @unique
  video         Video                @relation(fields: [videoId], references: [id])
  planText      String?
  rawFootageUrl String?
  cutScenesUrl  String?
  kitText       String?
  hardPartText  String?
  priceCents    Int                  @default(300)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  unlocks       BehindTheCutUnlock[]
}

/// One row per viewer who paid to unlock a video's Behind the Cut —
/// permanent access, not time-limited. A subscriber gets the same access
/// without needing one of these (checked directly against Subscription at
/// render time), so this table only covers per-video purchases.
model BehindTheCutUnlock {
  id                      String       @id @default(cuid())
  behindTheCutId          String
  behindTheCut            BehindTheCut @relation(fields: [behindTheCutId], references: [id])
  userId                  String
  user                    User         @relation(fields: [userId], references: [id])
  /// What was actually paid at unlock time — priceCents on BehindTheCut
  /// can change later, so this is the only accurate record for a creator's
  /// earnings history (same reasoning as Tip.amountCents).
  amountCents             Int
  stripeCheckoutSessionId String?      @unique
  createdAt               DateTime     @default(now())

  @@unique([behindTheCutId, userId])
}

/// The plan's "additional per-video items (all near-zero effort)": a
/// resource sheet, outtakes, or a paid attachment slot. Unlike Behind the
/// Cut's five fixed slots, a video can have any number of these, each
/// independently priced and unlocked — separate purchases, not one bundle.
enum VideoExtraType {
  RESOURCE_SHEET
  OUTTAKES
  ATTACHMENT
}

model VideoExtra {
  id         String             @id @default(cuid())
  videoId    String
  video      Video              @relation(fields: [videoId], references: [id])
  type       VideoExtraType
  title      String
  /// The written body for a RESOURCE_SHEET; null for the other types.
  text       String?
  /// The uploaded file for OUTTAKES (a video) or ATTACHMENT (any file
  /// type); null for RESOURCE_SHEET.
  fileUrl    String?
  priceCents Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  unlocks    VideoExtraUnlock[]

  @@index([videoId])
}

/// One row per viewer who paid to unlock a VideoExtra — same shape as
/// BehindTheCutUnlock, including a subscriber's free access being checked
/// directly against Subscription rather than living here.
model VideoExtraUnlock {
  id                      String     @id @default(cuid())
  videoExtraId            String
  videoExtra              VideoExtra @relation(fields: [videoExtraId], references: [id])
  userId                  String
  user                    User       @relation(fields: [userId], references: [id])
  amountCents             Int
  stripeCheckoutSessionId String?    @unique
  createdAt               DateTime   @default(now())

  @@unique([videoExtraId, userId])
}

enum MomentSource {
  /// A real GPT pass over the transcript (OPENAI_API_KEY set) — see
  /// src/lib/highlights.ts.
  AI
  /// The crowd-sourced fallback: moments 2+ viewers independently clipped
  /// near each other. Kept distinct from AI so the UI never claims a model
  /// suggested something it didn't.
  CROWD
  MANUAL
}

enum MomentStatus {
  SUGGESTED
  PUBLISHED
  /// Rejected (an AI suggestion the creator passed on) or retracted (a
  /// moment that was published and then pulled). Terminal either way —
  /// dismissed moments are never re-suggested or made public again.
  DISMISSED
}

/// A shareable, creator-approved clip of a video — the business plan's
/// signature "Curated Moments" feature. AI-suggested moments (pulled from
/// the transcript, see src/lib/curated-moments.ts) start as SUGGESTED and
/// are invisible to everyone but the creator until explicitly published;
/// a manually-added moment is published immediately since typing in the
/// times is itself the approval. Nothing here is ever public without a
/// deliberate creator action — see the plan's "you're never surprised"
/// rule.
model CuratedMoment {
  id               String            @id @default(cuid())
  videoId          String
  video            Video             @relation(fields: [videoId], references: [id])
  title            String
  startSeconds     Int
  endSeconds       Int
  source           MomentSource
  status           MomentStatus      @default(SUGGESTED)
  createdAt        DateTime          @default(now())
  publishedAt      DateTime?
  distributorLinks DistributorLink[]
  wallItems        WallItem[]

  @@index([videoId])
}

enum DubStatus {
  PROCESSING
  READY
  ERRORED
}

/// AI dubbing via ElevenLabs (V3 — "real-time or near-live AI dubbing with
/// voice cloning, via third-party providers, not built in-house" per the
/// business plan). Shared per video+language, not per viewer: once a dub
/// is ready, every viewer reuses the same audio file instead of
/// regenerating it. Only usable when ELEVENLABS_API_KEY is set.
model Dub {
  id                  String    @id @default(cuid())
  videoId             String
  video               Video     @relation(fields: [videoId], references: [id])
  requestedById       String
  requestedBy         User      @relation(fields: [requestedById], references: [id])
  /// ISO-639-1 code, e.g. "es" — see DUB_LANGUAGES in src/lib/integrations/elevenlabs.ts.
  targetLanguage      String
  status              DubStatus @default(PROCESSING)
  elevenLabsDubbingId String?   @unique
  audioUrl            String?
  error               String?
  createdAt           DateTime  @default(now())

  @@unique([videoId, targetLanguage])
}

/// A guest featured on an episode — a distinct identity from the creator
/// who can appear across multiple different creators' shows, so fans can
/// follow the person rather than just the show (V2 "guest-following").
/// Matched by exact name, not tied to a User account — guests don't need
/// their own login to be tagged and followed.
model Guest {
  id        String        @id @default(cuid())
  name      String        @unique
  bio       String?
  createdAt DateTime      @default(now())
  videos    VideoGuest[]
  followers GuestFollow[]
}

model VideoGuest {
  id      String @id @default(cuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id])
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id])

  @@unique([videoId, guestId])
}

model GuestFollow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation(fields: [followerId], references: [id])
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([followerId, guestId])
}

model Comment {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Follow {
  id         String         @id @default(cuid())
  followerId String
  follower   User           @relation(fields: [followerId], references: [id])
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([followerId, creatorId])
}

model Clip {
  id              String           @id @default(cuid())
  sourceVideoId   String
  sourceVideo     Video            @relation(fields: [sourceVideoId], references: [id])
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id])
  title           String
  startSeconds    Int
  endSeconds      Int
  createdAt       DateTime         @default(now())
  wallItems       WallItem[]
  liveClipRequest LiveClipRequest?
}

model WallItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  videoId   String?
  video     Video?         @relation(fields: [videoId], references: [id])
  clipId    String?
  clip      Clip?          @relation(fields: [clipId], references: [id])
  momentId  String?
  moment    CuratedMoment? @relation(fields: [momentId], references: [id])
  /// A short "why I saved this" note the viewer can add, per the
  /// personal-wall differentiation in the business plan.
  note      String?
  /// Incremented each time the owner revisits this saved video/clip (see
  /// src/lib/actions/wall-view.ts) — powers the Wall Card's "most-rewatched"
  /// stat. Not a general analytics/view-count system, just this.
  viewCount Int            @default(0)
  createdAt DateTime       @default(now())
}

/// A timestamped line of a video's transcript. Populated automatically by
/// OpenAI Whisper when OPENAI_API_KEY is set (see src/lib/integrations/openai.ts);
/// otherwise creators paste these in manually via the transcript editor.
model TranscriptSegment {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id])
  startSeconds Int
  text         String
  createdAt    DateTime @default(now())

  @@index([videoId])
}

/// Real when STRIPE_SECRET_KEY is set (stripeSubscriptionId identifies the
/// Stripe Subscription); otherwise a simulated ledger entry with no billing
/// behind it, same as before.
model Subscription {
  id                   String         @id @default(cuid())
  subscriberId         String
  subscriber           User           @relation(fields: [subscriberId], references: [id])
  creatorId            String
  creator              CreatorProfile @relation(fields: [creatorId], references: [id])
  stripeSubscriptionId String?        @unique
  /// Unguessable id for this subscriber's private podcast feed URL (see
  /// src/app/api/feed/[token]/route.ts) — a podcast app can't hold a
  /// session cookie, so the token itself is the access control. Not tied
  /// to email/password, so it can be regenerated without touching the
  /// account if a feed URL ever leaks.
  feedToken            String         @unique @default(cuid())
  createdAt            DateTime       @default(now())

  @@unique([subscriberId, creatorId])
}

/// Real when STRIPE_SECRET_KEY is set (stripeCheckoutSessionId identifies the
/// completed Checkout Session); otherwise a simulated ledger entry with no
/// payment behind it, same as before.
model Tip {
  id                      String              @id @default(cuid())
  /// Null for a guest tip (see src/lib/actions/guest-tip.ts) — guest
  /// checkout, per the plan, tips without requiring a platform account.
  fromUserId              String?
  fromUser                User?               @relation(fields: [fromUserId], references: [id])
  /// Set only for guest tips, from Stripe Checkout's own email collection —
  /// the only record of who a guest was, since there's no User row.
  guestEmail              String?
  toCreatorId             String
  toCreator               CreatorProfile      @relation(fields: [toCreatorId], references: [id])
  amountCents             Int
  message                 String?
  stripeCheckoutSessionId String?             @unique
  /// Set when this tip came through a distributor's share link — see
  /// DistributorLink. The split payout it produced, if any, is recorded
  /// separately as a DistributorEarning.
  distributorLinkId       String?
  distributorLink         DistributorLink?    @relation(fields: [distributorLinkId], references: [id])
  earning                 DistributorEarning?
  /// Stripe's card fingerprint for the payment method used — the only
  /// signal available to catch a guest tip that's really the distributor
  /// self-tipping through their own share link with no signed-in
  /// fromUserId to compare against directly. See splitDistributorPayout
  /// in the Stripe webhook.
  cardFingerprint         String?
  /// IP address the checkout was started from — the other self-referral
  /// signal alongside cardFingerprint, compared against
  /// DistributorLink.createdIp. Captured at checkout-creation time (the
  /// only point with a real browser request to read it from), for both
  /// the real and simulated tip paths.
  ipAddress               String?
  /// Stripe's PaymentIntent id for this tip's charge — how the webhook
  /// finds this Tip again when the charge is later refunded (see
  /// `charge.refunded` handling). Only ever set for real Stripe tips.
  stripePaymentIntentId   String?             @unique
  createdAt               DateTime            @default(now())

  @@index([cardFingerprint])
}

/// A viewer's personal share link for a Curated Moment — Distributor
/// Payouts, per the plan: "any viewer can grab a personal share link... if
/// their share leads to a tip... they automatically earn a cut." One link
/// per (distributor, moment) — regenerating just returns the same one.
/// Creating a link requires the distributor to have already completed
/// Stripe Connect onboarding (see requireDistributorPayoutsReady in
/// src/lib/actions/distributor.ts), so every link that exists is
/// guaranteed payable — there's no "onboard later" state to handle at
/// payout time.
model DistributorLink {
  id            String        @id @default(cuid())
  distributorId String
  distributor   User          @relation(fields: [distributorId], references: [id])
  momentId      String
  moment        CuratedMoment @relation(fields: [momentId], references: [id])
  /// IP address of the request that generated this link — one of the
  /// self-referral signals in splitDistributorPayout, alongside
  /// Tip.ipAddress and Tip.cardFingerprint. Best-effort like the others:
  /// shared networks (offices, NAT, VPNs) can share an IP legitimately.
  createdIp     String?
  createdAt     DateTime      @default(now())
  tips          Tip[]

  @@unique([distributorId, momentId])
}

/// The ledger of what a distributor actually earned from one tip — created
/// in the Stripe webhook once the split Transfer to their Connect account
/// succeeds. A one-to-one record per Tip, not a running balance, so a
/// future earnings page can just list/sum these directly.
model DistributorEarning {
  id               String    @id @default(cuid())
  distributorId    String
  distributor      User      @relation(fields: [distributorId], references: [id])
  tipId            String    @unique
  tip              Tip       @relation(fields: [tipId], references: [id])
  amountCents      Int
  /// The Transfer that actually paid the distributor — needed to reverse
  /// it if the underlying tip is later refunded. Null in simulated mode,
  /// where no real Transfer exists.
  stripeTransferId String?
  /// Set when the underlying tip's charge was refunded — the clawback.
  /// Kept as a row (not deleted) so the ledger still shows what happened;
  /// excluded from running totals wherever earnings are summed.
  refundedAt       DateTime?
  createdAt        DateTime  @default(now())
}

enum LiveStreamStatus {
  IDLE
  ACTIVE
  DISABLED
}

/// A creator's persistent Mux live stream target (RTMP URL + stream key).
/// Only usable when MUX_TOKEN_ID/MUX_TOKEN_SECRET are set.
model LiveStream {
  id              String            @id @default(cuid())
  creatorId       String            @unique
  creator         CreatorProfile    @relation(fields: [creatorId], references: [id])
  muxLiveStreamId String            @unique
  muxStreamKey    String
  muxPlaybackId   String
  status          LiveStreamStatus  @default(IDLE)
  /// Set when the current broadcast session flips to ACTIVE — the anchor
  /// viewer-clip timestamps are measured from (see LiveClipRequest). Reset
  /// on every new broadcast, since Mux reuses the same LiveStream row
  /// across sessions.
  wentLiveAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  chatMessages    LiveChatMessage[]
  clipRequests    LiveClipRequest[]
}

/// Polling-based chat during a live broadcast — same DB-backed approach as
/// listening-party chat (PartyMessage), no hosted real-time provider.
model LiveChatMessage {
  id           String     @id @default(cuid())
  liveStreamId String
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  body         String
  createdAt    DateTime   @default(now())

  @@index([liveStreamId, createdAt])
}

/// A viewer's "clip this moment" request made *during* a live broadcast —
/// V2 Tier 2's real-time viewer clipping. There's no Video/VOD to point a
/// Clip at yet while the stream is live, so this just marks a moment
/// (seconds elapsed since LiveStream.wentLiveAt); once the stream ends and
/// Mux's recording asset is ready (see the mux webhook), it's materialized
/// into a real Clip covering the ~30s before the marked moment, and
/// resultClipId is set. An approximation, not frame-accurate — same
/// caveat as regular clip trimming on Mux-hosted sources.
model LiveClipRequest {
  id              String     @id @default(cuid())
  liveStreamId    String
  liveStream      LiveStream @relation(fields: [liveStreamId], references: [id])
  ownerId         String
  owner           User       @relation(fields: [ownerId], references: [id])
  title           String
  markedAtSeconds Int
  resultClipId    String?    @unique
  resultClip      Clip?      @relation(fields: [resultClipId], references: [id])
  createdAt       DateTime   @default(now())
}

/// An AI-generated audio summary of a viewer's wall, per the "commute
/// briefing" feature. Only buildable when OPENAI_API_KEY is set.
model Briefing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  script    String
  audioUrl  String
  createdAt DateTime @default(now())
}

/// V2 Tier 1 live/togetherness: synchronized playback of an existing
/// episode at a set time, with a shared chat. No live-streaming
/// infrastructure required — the video already exists, this just
/// coordinates when people watch it together.
model ListeningParty {
  id          String         @id @default(cuid())
  videoId     String
  video       Video          @relation(fields: [videoId], references: [id])
  scheduledAt DateTime
  createdAt   DateTime       @default(now())
  messages    PartyMessage[]
  rsvps       PartyRsvp[]
}

/// Polling-based chat (no hosted real-time provider configured yet — see
/// src/lib/actions/party.ts). Swappable for a real-time service like
/// Pusher/Ably later without changing this shape.
model PartyMessage {
  id        String         @id @default(cuid())
  partyId   String
  party     ListeningParty @relation(fields: [partyId], references: [id])
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime       @default(now())

  @@index([partyId, createdAt])
}

model PartyRsvp {
  id        String         @id @default(cuid())
  partyId   String
  party     ListeningParty @relation(fields: [partyId], references: [id])
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([partyId, userId])
}

/// Records that a viewer generated their shareable Wall Card for a given
/// month — the platform's primary viral loop. The image itself is rendered
/// on demand (src/app/api/wall-card/[userId]/route.tsx) from live wall
/// data, not stored; this row just tracks the monthly-drop cadence (one per
/// user per month) so the wall page can show "already generated this
/// month" and a history of past drops.
model WallCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// Calendar month the card represents, e.g. "2026-09".
  month     String
  createdAt DateTime @default(now())

  @@unique([userId, month])
}

/// Records that a viewer generated their weekly Recap Reel — a habit/identity
/// image (see the business plan's "recap reels") summarizing that week's
/// activity: streak, active days, comments, follows, saves. Rendered on
/// demand (src/app/api/recap/[userId]/route.tsx) from live activity data,
/// not stored; this row just tracks the weekly-drop cadence, same pattern
/// as WallCard's monthly one. Distinct from WallCard: this is about the
/// viewer's own habit/activity, not their saved wall.
model RecapReel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// Monday of the recapped week, UTC, e.g. "2026-09-01".
  weekStart String
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

/// One row per (user, calendar day) they visited a video or clip — the
/// whole signal behind streaks (see src/lib/streaks.ts). Deliberately not a
/// general analytics table, just enough to compute "days in a row."
model DailyActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  /// "YYYY-MM-DD" in UTC.
  date   String

  @@unique([userId, date])
}

/// A permanent, public, indexable "ask the show" answer — the plan's
/// growth-loop bet that every answered question becomes a shareable,
/// search-findable page on day one. See src/lib/actions/ask.ts. Answered
/// automatically, with no creator approval step, unlike Curated Moments —
/// this is just a computed answer over the creator's own already-public
/// transcript, not a viewer editorial decision that could misrepresent them.
model AskedQuestion {
  id          String         @id @default(cuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id])
  askedById   String?
  askedBy     User?          @relation(fields: [askedById], references: [id])
  question    String
  /// Null when OPENAI_API_KEY isn't set — the page still shows the matched
  /// source excerpts, just without a synthesized answer.
  answer      String?
  /// Cached AskSource[] (see src/lib/actions/ask.ts) — a snapshot of what
  /// was found at the time this was asked, not re-queried live.
  sourcesJson Json
  createdAt   DateTime       @default(now())

  @@index([creatorId])
}

enum PaidQuestionStatus {
  PENDING
  ANSWERED
}

/// "Paid questions: viewers pay to submit a question for the next
/// episode." Priced per-creator via CreatorProfile.questionPriceCents —
/// null there means the creator hasn't turned this on.
model PaidQuestion {
  id                      String             @id @default(cuid())
  creatorId               String
  creator                 CreatorProfile     @relation(fields: [creatorId], references: [id])
  fromUserId              String
  fromUser                User               @relation(fields: [fromUserId], references: [id])
  question                String
  amountCents             Int
  status                  PaidQuestionStatus @default(PENDING)
  /// Set by the creator once they've answered it in a video — how a viewer
  /// finds out where their question was addressed.
  answeredVideoId         String?
  answeredVideo           Video?             @relation(fields: [answeredVideoId], references: [id])
  stripeCheckoutSessionId String?            @unique
  createdAt               DateTime           @default(now())

  @@index([creatorId])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  createdAt      DateTime        @default(now())
  creatorProfile CreatorProfile?
  comments       Comment[]
  follows        Follow[]
  clips          Clip[]
  wallItems      WallItem[]
  tipsSent       Tip[]
  subscriptions  Subscription[]
}

model CreatorProfile {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  user                   User           @relation(fields: [userId], references: [id])
  handle                 String         @unique
  displayName            String
  bio                    String?
  subscriptionPriceCents Int?
  createdAt              DateTime       @default(now())
  videos                 Video[]
  followers              Follow[]
  tipsReceived           Tip[]
  subscribers            Subscription[]
}

model Video {
  id             String              @id @default(cuid())
  creatorId      String
  creator        CreatorProfile      @relation(fields: [creatorId], references: [id])
  title          String
  description    String?
  videoUrl       String
  subscriberOnly Boolean             @default(false)
  createdAt      DateTime            @default(now())
  comments       Comment[]
  clips          Clip[]
  wallItems      WallItem[]
  transcript     TranscriptSegment[]
}

model Comment {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Follow {
  id         String         @id @default(cuid())
  followerId String
  follower   User           @relation(fields: [followerId], references: [id])
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([followerId, creatorId])
}

model Clip {
  id            String     @id @default(cuid())
  sourceVideoId String
  sourceVideo   Video      @relation(fields: [sourceVideoId], references: [id])
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id])
  title         String
  startSeconds  Int
  endSeconds    Int
  createdAt     DateTime   @default(now())
  wallItems     WallItem[]
}

model WallItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id])
  clipId    String?
  clip      Clip?    @relation(fields: [clipId], references: [id])
  createdAt DateTime @default(now())
}

/// A timestamped line of a video's transcript. Creators paste these in
/// manually for now (see the transcript editor) — there's no speech-to-text
/// pipeline wired up yet — but this is the same shape real ASR output would
/// fill in, so search and the commute briefing can build on it either way.
model TranscriptSegment {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id])
  startSeconds Int
  text         String
  createdAt    DateTime @default(now())

  @@index([videoId])
}

/// A simulated subscription — no billing provider is wired up yet, so this
/// just records that a viewer subscribed, the same way Tip records a
/// payment that never actually moved money.
model Subscription {
  id           String         @id @default(cuid())
  subscriberId String
  subscriber   User           @relation(fields: [subscriberId], references: [id])
  creatorId    String
  creator      CreatorProfile @relation(fields: [creatorId], references: [id])
  createdAt    DateTime       @default(now())

  @@unique([subscriberId, creatorId])
}

model Tip {
  id          String         @id @default(cuid())
  fromUserId  String
  fromUser    User           @relation(fields: [fromUserId], references: [id])
  toCreatorId String
  toCreator   CreatorProfile @relation(fields: [toCreatorId], references: [id])
  amountCents Int
  message     String?
  createdAt   DateTime       @default(now())
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  name             String
  stripeCustomerId String?         @unique
  createdAt        DateTime        @default(now())
  creatorProfile   CreatorProfile?
  comments         Comment[]
  follows          Follow[]
  clips            Clip[]
  wallItems        WallItem[]
  tipsSent         Tip[]
  subscriptions    Subscription[]
  briefings        Briefing[]
}

model CreatorProfile {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  user                   User           @relation(fields: [userId], references: [id])
  handle                 String         @unique
  displayName            String
  bio                    String?
  subscriptionPriceCents Int?
  createdAt              DateTime       @default(now())
  videos                 Video[]
  followers              Follow[]
  tipsReceived           Tip[]
  subscribers            Subscription[]
  liveStream             LiveStream?
}

enum VideoStatus {
  PROCESSING
  READY
  ERRORED
}

model Video {
  id             String              @id @default(cuid())
  creatorId      String
  creator        CreatorProfile      @relation(fields: [creatorId], references: [id])
  title          String
  description    String?
  /// Null while a Mux-hosted upload is still processing (see `status`).
  videoUrl       String?
  status         VideoStatus         @default(READY)
  /// Set for uploads routed through Mux (see src/lib/integrations/mux.ts).
  muxUploadId    String?             @unique
  muxAssetId     String?
  muxPlaybackId  String?
  subscriberOnly Boolean             @default(false)
  createdAt      DateTime            @default(now())
  comments       Comment[]
  clips          Clip[]
  wallItems      WallItem[]
  transcript     TranscriptSegment[]
}

model Comment {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Follow {
  id         String         @id @default(cuid())
  followerId String
  follower   User           @relation(fields: [followerId], references: [id])
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([followerId, creatorId])
}

model Clip {
  id            String     @id @default(cuid())
  sourceVideoId String
  sourceVideo   Video      @relation(fields: [sourceVideoId], references: [id])
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id])
  title         String
  startSeconds  Int
  endSeconds    Int
  createdAt     DateTime   @default(now())
  wallItems     WallItem[]
}

model WallItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id])
  clipId    String?
  clip      Clip?    @relation(fields: [clipId], references: [id])
  createdAt DateTime @default(now())
}

/// A timestamped line of a video's transcript. Populated automatically by
/// OpenAI Whisper when OPENAI_API_KEY is set (see src/lib/integrations/openai.ts);
/// otherwise creators paste these in manually via the transcript editor.
model TranscriptSegment {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id])
  startSeconds Int
  text         String
  createdAt    DateTime @default(now())

  @@index([videoId])
}

/// Real when STRIPE_SECRET_KEY is set (stripeSubscriptionId identifies the
/// Stripe Subscription); otherwise a simulated ledger entry with no billing
/// behind it, same as before.
model Subscription {
  id                   String         @id @default(cuid())
  subscriberId         String
  subscriber           User           @relation(fields: [subscriberId], references: [id])
  creatorId            String
  creator              CreatorProfile @relation(fields: [creatorId], references: [id])
  stripeSubscriptionId String?        @unique
  createdAt            DateTime       @default(now())

  @@unique([subscriberId, creatorId])
}

/// Real when STRIPE_SECRET_KEY is set (stripeCheckoutSessionId identifies the
/// completed Checkout Session); otherwise a simulated ledger entry with no
/// payment behind it, same as before.
model Tip {
  id                      String         @id @default(cuid())
  fromUserId              String
  fromUser                User           @relation(fields: [fromUserId], references: [id])
  toCreatorId             String
  toCreator               CreatorProfile @relation(fields: [toCreatorId], references: [id])
  amountCents             Int
  message                 String?
  stripeCheckoutSessionId String?        @unique
  createdAt               DateTime       @default(now())
}

enum LiveStreamStatus {
  IDLE
  ACTIVE
  DISABLED
}

/// A creator's persistent Mux live stream target (RTMP URL + stream key).
/// Only usable when MUX_TOKEN_ID/MUX_TOKEN_SECRET are set.
model LiveStream {
  id              String           @id @default(cuid())
  creatorId       String           @unique
  creator         CreatorProfile   @relation(fields: [creatorId], references: [id])
  muxLiveStreamId String           @unique
  muxStreamKey    String
  muxPlaybackId   String
  status          LiveStreamStatus @default(IDLE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// An AI-generated audio summary of a viewer's wall, per the "commute
/// briefing" feature. Only buildable when OPENAI_API_KEY is set.
model Briefing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  script    String
  audioUrl  String
  createdAt DateTime @default(now())
}
